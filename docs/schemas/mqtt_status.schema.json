{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hcdmap/schemas/mqtt_status.schema.json",
  "title": "MQTT camera status",
  "type": "object",
  "required": ["state"],
  "additionalProperties": true,
  "properties": {
    "state": { "enum": ["online", "degraded", "offline"] },
    "reason": { "enum": ["ok", "occluded", "low_light", "moved", "rtsp_lost", "lwt"] }
  }
}
